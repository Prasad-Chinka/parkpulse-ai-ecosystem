# Server and Database Configuration
PORT=3000
# MongoDB Atlas Connection URI (optional: runs with auto-seeded persistent in-memory fallback if not provided)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/parkpulse?retryWrites=true&w=majority

# Authentication
JWT_SECRET=parkpulse_super_secret_jwt_key_2026

# Gemini AI API Key (Injected automatically in AI Studio, or provide your key)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Razorpay Test Credentials (optional: uses realistic interactive Demo Payment Gateway if not set)
RAZORPAY_KEY_ID=rzp_test_exampleKey
RAZORPAY_KEY_SECRET=exampleSecretKey

# Application URL
APP_URL="http://localhost:3000"
